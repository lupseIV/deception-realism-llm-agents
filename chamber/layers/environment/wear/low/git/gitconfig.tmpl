[user]
	name = {{.FullName}}
	email = {{.User}}@{{.Domain}}
[core]
	editor = vim
	excludesfile = ~/.config/git/ignore
[init]
	defaultBranch = main
[pull]
	rebase = true
[fetch]
	prune = true
[credential "https://{{.GitHost}}"]
	helper = cache --timeout=28800
[alias]
	st = status -sb
	co = checkout
	lg = log --oneline --graph --decorate
